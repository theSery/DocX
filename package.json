{
  "name": "DocX",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check-env": "node scripts/check-env.js",
    "android": "npm run check-env && react-native run-android",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "ios": "npm run check-env && react-native run-ios",
    "lint": "eslint .",
    "start": "npm run check-env && react-native start",
    "start:reset": "npm run check-env && watchman watch-del-all && react-native start --reset-cache",
    "podInstall": "cd ios && bundle exec pod install && cd ..",
    "link-assets": "npx react-native-asset",
    "test": "jest",
    "clean": "rimraf node_modules package-lock.json ios/build ios/Pods ios/Podfile.lock"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.18.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@sbaiahmed1/react-native-blur": "^6.0.0",
    "@shopify/react-native-skia": "^2.6.2",
    "axios": "^1.16.1",
    "lottie-react-native": "^7.3.8",
    "react": "19.2.3",
    "react-hook-form": "^7.76.0",
    "react-native": "0.85.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.25.1",
    "react-native-share": "^12.3.1",
    "react-native-splash-view": "^0.0.21",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.10.2",
    "react-native-youtube-iframe": "^2.4.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ENABLE_SHARED_ELEMENT_TRANSITIONS": true
    }
  }
}
